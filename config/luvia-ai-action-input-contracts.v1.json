{
  "contractId": "luvia.ai-action-input-contracts.v1",
  "version": "1.0.0",
  "actionContractId": "intelligence.actions.v1",
  "enforcement": "BOUNDED_RUNTIME_ENFORCEMENT_ACTIVE",
  "runtimeEnforcement": {
    "policyCore": "intelligence.actions.v1",
    "runtimeEnforcedActionIds": ["navigation.route.open", "places.place.favorite", "places.place.unfavorite", "places.place.plan", "places.place.unplan", "booking.place.open", "booking.stay.search", "booking.stay.offer.open", "booking.trip.read", "booking.reservation.create", "booking.reservation.modify", "booking.reservation.cancel", "journey.day.read", "journey.day.open", "journey.entry.schedule", "journey.entry.remove", "journey.entry.restore", "trip.active.list", "trip.active.select", "trip.update.details", "places.restaurant.recommend", "places.discovery.recommend", "events.verified.read", "memory.library.read", "memory.story.save", "identity.preferences.read", "identity.preferences.update"],
    "metadataValidatedOpenActionIds": 0,
    "rejectsBeforeLedgerAndOwnerInvocation": true
  },
  "context": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "surface": { "type": "string", "minLength": 1, "maxLength": 80 },
      "tripId": { "type": "string", "minLength": 1, "maxLength": 160 },
      "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
      "timeZone": { "type": "string", "minLength": 1, "maxLength": 80 }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "id": { "type": "string", "minLength": 1, "maxLength": 240 },
    "query": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "patch": { "type": "object", "minProperties": 1, "maxProperties": 40 }
  },
  "contracts": {
    "navigation.route.open": {
      "schemaId": "luvia.ai-input.navigation.route.open.v1",
      "required": ["route"],
      "optional": ["source", "query"],
      "context": ["surface", "locale"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route"],
        "properties": {
          "route": { "enum": ["today", "plan", "trip", "memories", "more", "places", "hotels", "places-lifecycle", "timeline", "routes", "gallery", "albums", "bookings", "control-center", "control-center-identity", "control-center-bookings", "control-center-inbox", "profile-onboarding", "first-trip-composer"] },
          "source": { "type": "string", "minLength": 1, "maxLength": 120 },
          "query": { "$ref": "#/$defs/query" }
        }
      }
    },
    "places.restaurant.recommend": {
      "schemaId": "luvia.ai-input.places.restaurant.recommend.v1",
      "required": ["query"],
      "optional": ["category", "categories", "limit", "explicitPreferencePatch", "spatialConstraints", "strictPlaceType", "mutationHints"],
      "context": ["surface", "tripId", "locale", "timeZone"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": { "$ref": "#/$defs/query" },
          "category": { "type": "string", "minLength": 1, "maxLength": 80 },
          "categories": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
          "limit": { "type": "integer", "minimum": 1, "maximum": 12 },
          "explicitPreferencePatch": { "type": "object", "maxProperties": 30 },
          "spatialConstraints": { "type": ["object", "null"] },
          "strictPlaceType": { "type": ["string", "null"], "maxLength": 80 },
          "mutationHints": { "type": "object", "maxProperties": 6 }
        }
      }
    },
    "places.discovery.recommend": {
      "schemaId": "luvia.ai-input.places.discovery.recommend.v1",
      "required": ["query"],
      "optional": ["category", "categories", "limit", "explicitPreferencePatch", "spatialConstraints", "strictPlaceType", "mutationHints"],
      "context": ["surface", "tripId", "locale", "timeZone"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": { "$ref": "#/$defs/query" },
          "category": { "type": "string", "minLength": 1, "maxLength": 80 },
          "categories": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
          "limit": { "type": "integer", "minimum": 1, "maximum": 12 },
          "explicitPreferencePatch": { "type": "object", "maxProperties": 30 },
          "spatialConstraints": { "type": ["object", "null"] },
          "strictPlaceType": { "type": ["string", "null"], "maxLength": 80 },
          "mutationHints": { "type": "object", "maxProperties": 6 }
        }
      }
    },
    "events.verified.read": {
      "schemaId": "luvia.ai-input.events.verified.read.v1",
      "required": [],
      "optional": ["query", "from", "to", "limit"],
      "context": ["surface", "tripId", "locale", "timeZone"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": { "$ref": "#/$defs/query" },
          "from": { "type": ["string", "null"], "format": "date-time" },
          "to": { "type": ["string", "null"], "format": "date-time" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
        }
      }
    },
    "places.place.favorite": {
      "schemaId": "luvia.ai-input.places.place.favorite.v1",
      "required": ["tripId", "providerPlaceId"],
      "optional": ["placeId", "tripPlaceId", "placeType", "name", "address", "website", "reservationUrl"],
      "context": ["surface", "tripId", "locale", "timeZone"],
      "input": { "$ref": "#/$defsExpanded/placeAction" }
    },
    "places.place.unfavorite": {
      "schemaId": "luvia.ai-input.places.place.unfavorite.v1",
      "required": ["tripId", "providerPlaceId"],
      "optional": ["placeId", "tripPlaceId", "placeType", "name", "address", "website", "reservationUrl"],
      "context": ["surface", "tripId", "locale", "timeZone"],
      "input": { "$ref": "#/$defsExpanded/placeAction" }
    },
    "places.place.plan": {
      "schemaId": "luvia.ai-input.places.place.plan.v1",
      "required": ["tripId", "fields"],
      "optional": ["providerPlaceId", "placeId", "tripPlaceId", "placeType", "name", "date", "time", "requestedBy"],
      "context": ["surface", "tripId", "locale", "timeZone"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tripId", "fields"],
        "anyOf": [{ "required": ["providerPlaceId"] }, { "required": ["tripPlaceId"] }],
        "properties": {
          "tripId": { "$ref": "#/$defs/id" },
          "providerPlaceId": { "$ref": "#/$defs/id" },
          "placeId": { "$ref": "#/$defs/id" },
          "tripPlaceId": { "$ref": "#/$defs/id" },
          "placeType": { "type": "string", "minLength": 1, "maxLength": 80 },
          "name": { "type": "string", "minLength": 1, "maxLength": 240 },
          "date": { "$ref": "#/$defs/date" },
          "time": { "$ref": "#/$defs/time" },
          "fields": {
            "type": "object",
            "additionalProperties": true,
            "required": ["planned_at"],
            "properties": { "planned_at": { "$ref": "#/$defs/dateTime" } }
          },
          "requestedBy": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "places.place.unplan": {
      "schemaId": "luvia.ai-input.places.place.unplan.v1",
      "required": ["tripId", "tripPlaceId"],
      "optional": ["providerPlaceId", "placeId", "placeType", "name", "fields"],
      "context": ["surface", "tripId", "locale", "timeZone"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tripId", "tripPlaceId"],
        "properties": {
          "tripId": { "$ref": "#/$defs/id" },
          "tripPlaceId": { "$ref": "#/$defs/id" },
          "providerPlaceId": { "$ref": "#/$defs/id" },
          "placeId": { "$ref": "#/$defs/id" },
          "placeType": { "type": "string", "maxLength": 80 },
          "name": { "type": "string", "maxLength": 240 },
          "fields": { "type": ["array", "object"], "maxItems": 20 }
        }
      }
    },
    "booking.place.open": {
      "schemaId": "luvia.ai-input.booking.place.open.v1",
      "required": ["providerPlaceId"],
      "optional": ["tripId", "placeId", "placeType", "type", "name", "address", "website", "reservationUrl"],
      "context": ["surface", "tripId", "locale", "timeZone"],
      "input": { "$ref": "#/$defsExpanded/placeOpen" }
    },
    "booking.stay.search": {
      "schemaId": "luvia.ai-input.booking.stay.search.v1",
      "required": ["checkIn", "checkOut", "adults", "children", "childAges", "rooms", "currency"],
      "optional": ["query", "tripId", "destination", "cityCode", "latitude", "longitude", "providerDestinationIds", "providerHotelIds", "providers"],
      "context": ["surface", "tripId", "locale", "timeZone"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkIn", "checkOut", "adults", "children", "childAges", "rooms", "currency"],
        "properties": {
          "query": { "$ref": "#/$defs/query" },
          "tripId": { "$ref": "#/$defs/id" },
          "destination": { "type": ["string", "null"], "maxLength": 240 },
          "cityCode": { "type": ["string", "null"], "pattern": "^[A-Za-z]{3}$" },
          "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
          "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
          "providerDestinationIds": { "type": "object", "maxProperties": 8, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 120 } },
          "providerHotelIds": { "type": "object", "maxProperties": 8 },
          "checkIn": { "$ref": "#/$defs/date" },
          "checkOut": { "$ref": "#/$defs/date" },
          "adults": { "type": "integer", "minimum": 1, "maximum": 100 },
          "children": { "type": "integer", "minimum": 0, "maximum": 30 },
          "childAges": { "type": "array", "maxItems": 30, "items": { "type": "integer", "minimum": 0, "maximum": 17 } },
          "rooms": { "type": "integer", "minimum": 1, "maximum": 30 },
          "currency": { "type": "string", "pattern": "^[A-Za-z]{3}$" },
          "providers": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "enum": ["duffel_stays", "hotelbeds", "amadeus_hotels"] } }
        }
      }
    },
    "booking.stay.offer.open": {
      "schemaId": "luvia.ai-input.booking.stay.offer.open.v1",
      "required": ["offer", "query"],
      "optional": ["tripId"],
      "context": ["surface", "tripId", "locale", "timeZone"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["offer", "query"],
        "properties": {
          "tripId": { "$ref": "#/$defs/id" },
          "offer": { "type": "object", "minProperties": 12, "maxProperties": 60 },
          "query": { "type": "object", "minProperties": 7, "maxProperties": 40 }
        }
      }
    },
    "booking.trip.read": {
      "schemaId": "luvia.ai-input.booking.trip.read.v1",
      "required": [],
      "optional": ["query", "intent"],
      "context": ["surface", "tripId", "locale", "timeZone"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": { "$ref": "#/$defs/query" },
          "intent": { "enum": ["list", "prerequisite-read", "modify", "cancel"] }
        }
      }
    },
    "booking.reservation.create": {
      "schemaId": "luvia.ai-input.booking.reservation.create.v1",
      "required": ["tripId", "place", "startAt", "partySize"],
      "optional": ["tripPlaceId", "placeId", "providerPlaceId", "placeType", "title", "name", "date", "time", "endAt", "timezone", "requesterName", "occasion", "note", "email", "emailVerified", "emailVerificationSource", "provider", "venueReference", "providerSlotReference", "preferProviderApi", "route"],
      "context": ["surface", "tripId", "locale", "timeZone"],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tripId", "place", "startAt", "partySize"],
        "properties": {
          "tripId": { "$ref": "#/$defs/id" },
          "tripPlaceId": { "$ref": "#/$defs/id" },
          "placeId": { "$ref": "#/$defs/id" },
          "providerPlaceId": { "$ref": "#/$defs/id" },
          "placeType": { "type": "string", "maxLength": 80 },
          "title": { "type": "string", "maxLength": 240 },
          "name": { "type": "string", "maxLength": 240 },
          "date": { "$ref": "#/$defs/date" },
          "time": { "$ref": "#/$defs/time" },
          "startAt": { "type": "string", "format": "date-time" },
          "endAt": { "type": ["string", "null"], "format": "date-time" },
          "partySize": { "type": "integer", "minimum": 1, "maximum": 100 },
          "timezone": { "type": "string", "minLength": 1, "maxLength": 80 },
          "requesterName": { "type": "string", "maxLength": 160 },
          "occasion": { "type": "string", "maxLength": 240 },
          "note": { "type": "string", "maxLength": 2000 },
          "email": { "type": "string", "maxLength": 320 },
          "emailVerified": { "type": "boolean" },
          "emailVerificationSource": { "type": "string", "maxLength": 2000 },
          "provider": { "type": "string", "maxLength": 120 },
          "venueReference": { "$ref": "#/$defs/id" },
          "providerSlotReference": { "$ref": "#/$defs/id" },
          "preferProviderApi": { "type": "boolean" },
          "route": { "type": ["object", "null"], "maxProperties": 20 },
          "place": { "$ref": "#/$defsExpanded/placeOpen" }
        }
      }
