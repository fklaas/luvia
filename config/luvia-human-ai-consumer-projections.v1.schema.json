{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luvia.local/contracts/luvia-human-ai-consumer-projections.v1.schema.json",
  "title": "Luvia Human-AI Consumer Projections v1",
  "type": "object",
  "required": ["contractId", "version", "invariants", "summary", "projections"],
  "properties": {
    "contractId": { "const": "luvia.human-ai-consumer-projections.v1" },
    "version": { "const": "1.0.0" },
    "invariants": {
      "type": "object",
      "required": ["normalSurfaceTechnicalVocabulary", "singleResolvedIntentRepeated", "datesUseGermanDayMonthYear", "blockedCapabilityPresentedAsAvailable"]
    },
    "summary": {
      "type": "object",
      "required": ["catalogActions", "projectedActions", "consumerViews", "capabilityStates", "technicalVocabularyHidden", "duplicateSingleIntentSuppressed", "dateFormat"]
    },
    "projections": {
      "type": "array",
      "minItems": 327,
      "maxItems": 327,
      "items": {
        "type": "object",
        "required": ["actionId", "state", "view", "tone", "hidden", "title", "message", "requiresConfirmation", "actionMode"]
      }
    }
  }
}
