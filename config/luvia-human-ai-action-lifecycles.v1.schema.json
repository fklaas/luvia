{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luvia.local/contracts/luvia-human-ai-action-lifecycles.v1.schema.json",
  "title": "Luvia Human-AI Action Lifecycles v1",
  "type": "object",
  "required": ["contractId", "version", "invariants", "summary", "lifecycles"],
  "properties": {
    "contractId": { "const": "luvia.human-ai-action-lifecycles.v1" },
    "version": { "const": "1.0.0" },
    "invariants": { "type": "object", "required": ["rawPayloadStored", "naturalLanguageAloneConfirmsMutation", "separateVisibleConfirmation", "unknownExternalBlindRetry"] },
    "summary": { "type": "object", "required": ["catalogActions", "lifecycleActions", "stateChanging", "truthfulUndo", "modes"] },
    "lifecycles": {
      "type": "array", "minItems": 329, "maxItems": 329,
      "items": {
        "type": "object",
        "required": ["actionId", "mode", "stateChanging", "preview", "confirmation", "idempotency", "receipt", "readback", "recovery", "undo", "stages"],
        "properties": {
          "actionId": { "type": "string", "minLength": 3 },
          "mode": { "enum": ["READ_ONLY", "OPEN_ONLY", "DRAFT_ONLY", "PRESENTATION_ONLY", "PERMISSION_REQUEST", "EXTERNAL_HANDOFF", "MUTATION", "CONTROL_MUTATION"] },
          "stateChanging": { "type": "boolean" },
          "stages": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
