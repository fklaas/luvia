{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.luvia.app/human-ai-parity-failure-matrix.v1.schema.json",
  "title": "Luvia Human-AI Parity and Failure Matrix v1",
  "type": "object",
  "required": ["contractId", "version", "source", "invariants", "dimensions", "summary", "rows"],
  "properties": {
    "contractId": { "const": "luvia.human-ai-parity-failure-matrix.v1" },
    "version": { "const": "1.0.0" },
    "dimensions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "enum": ["contract", "compiler", "permission", "confirmation", "idempotency", "receipt", "recovery", "undo", "multilingual", "typo", "multiIntent", "denial"] }
    },
    "summary": {
      "type": "object",
      "required": ["catalogActions", "matrixRows", "dimensions", "releaseStatus", "generatedFailureCases", "driftGuard", "ownerExecution"]
    },
    "rows": {
      "type": "array",
      "minItems": 327,
      "maxItems": 327,
      "items": {
        "type": "object",
        "required": ["sequence", "actionId", "label", "category", "effect", "risk", "owner", "ai", "release", "dimensions", "failures"],
        "properties": {
          "actionId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
          "release": {
            "type": "object",
            "required": ["status", "publicEvidence", "blockers"],
            "properties": {
              "status": { "enum": ["PUBLIC_E2E_PROVEN", "LOCAL_AI_PATH", "MANUAL_OWNER_PATH", "BLOCKED", "NOT_APPLICABLE"] }
            }
          },
          "dimensions": { "type": "object", "minProperties": 12, "maxProperties": 12 },
          "failures": { "type": "array", "minItems": 4 }
        }
      }
    }
  }
}
