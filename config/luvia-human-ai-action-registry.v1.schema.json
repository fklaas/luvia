{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.luvia.app/human-ai-action-registry.v1.schema.json",
  "title": "Luvia Human ↔ AI Action Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "version",
    "generatedAt",
    "source",
    "invariants",
    "summary",
    "runtimeActionIds",
    "actions",
    "unavailableOutcomes",
    "markerAudit"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "contractId": { "const": "luvia.human-ai-action-registry.v1" },
    "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "generatedAt": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workbook", "workbookSha256", "snapshotDate", "integrationBuild", "scope"],
      "properties": {
        "workbook": { "type": "string", "minLength": 1 },
        "workbookSha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "snapshotDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "integrationBuild": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanAiParity", "sameOwnerBoundary", "naturalLanguageAloneConfirmsMutation", "publicE2eRequiredForPass", "newUiActionRequiresRegistryDecision"],
      "properties": {
        "humanAiParity": { "const": "NO_PRODUCT_EXCEPTION" },
        "sameOwnerBoundary": { "const": true },
        "naturalLanguageAloneConfirmsMutation": { "const": false },
        "publicE2eRequiredForPass": { "const": true },
        "newUiActionRequiresRegistryDecision": { "const": true }
      }
    },
    "summary": { "type": "object" },
    "runtimeActionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "unavailableOutcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/unavailableOutcome" }
    },
    "markerAudit": { "type": "object" }
  },
  "$defs": {
    "sourceList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "id", "category", "area", "label", "surface", "human", "effect", "risk", "owner", "ai", "inputContract", "lifecycle", "delivery", "sources", "note"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
        "category": { "type": "string", "minLength": 1 },
        "area": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "human": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sourceStatus"],
          "properties": {
            "status": { "enum": ["AVAILABLE", "CONDITIONAL", "DEMO_ONLY", "UNKNOWN"] },
            "sourceStatus": { "type": "string", "minLength": 1 }
          }
        },
        "effect": { "enum": ["READ", "NAVIGATION", "PRESENTATION", "DRAFT", "WRITE", "EXTERNAL", "PERMISSION", "DEMO"] },
        "risk": { "enum": ["R0", "R1", "R2", "R3", "R4", "R1–R2", "R1–R4"] },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "domains", "primaryDomain", "contract", "method", "bindingStatus"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "domains": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "primaryDomain": { "type": ["string", "null"] },
            "contract": { "type": ["string", "null"] },
            "method": { "type": ["string", "null"] },
            "operationKey": { "type": ["string", "null"] },
            "bindingStatus": { "enum": ["NOT_APPLICABLE", "OWNER_DOMAIN_OPEN", "OWNER_METHOD_AUDIT_OPEN", "PUBLIC_CONTRACT_BOUND", "RUNTIME_REGISTERED", "PUBLIC_E2E_PROVEN"] }
          }
        },
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coverage", "sourceCoverage", "actionId", "runtimeRegistered"],
          "properties": {
            "coverage": { "enum": ["MISSING", "NATIVE_CHAT", "NOT_APPLICABLE", "NOT_REQUIRED", "PARTIAL", "PUBLIC_E2E_PASS", "REGISTERED_PARTIAL", "UNKNOWN"] },
            "sourceCoverage": { "type": "string", "minLength": 1 },
            "actionId": { "type": ["string", "null"] },
            "runtimeRegistered": { "type": "boolean" }
          }
        },
        "inputContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "schemaId", "requiredFields", "optionalFields", "contextFields"],
          "properties": {
            "status": { "enum": ["OPEN", "REGISTERED_SCHEMA_AUDIT_OPEN", "NATIVE_CHAT_CONTROL", "NOT_APPLICABLE", "READY"] },
            "schemaId": { "type": ["string", "null"] },
            "requiredFields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "optionalFields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "contextFields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stateChanging", "confirmationPolicy", "confirmationDescription", "idempotency", "reversible", "compensationActionId", "recoveryDescription", "lifecycleAuditStatus"],
          "properties": {
            "stateChanging": { "type": "boolean" },
            "confirmationPolicy": { "enum": ["NEVER", "USER_GESTURE", "OWNER_COMMIT", "OWNER_MULTI_STEP", "EXPLICIT", "POLICY_OPEN"] },
            "confirmationDescription": { "type": "string", "minLength": 1 },
            "idempotency": { "enum": ["NONE", "OPTIONAL", "REQUIRED"] },
            "reversible": { "type": ["boolean", "null"] },
            "compensationActionId": { "type": ["string", "null"] },
            "recoveryDescription": { "type": "string", "minLength": 1 },
            "lifecycleAuditStatus": { "enum": ["OPEN", "REGISTERED_ACTION_AUDIT_OPEN", "NOT_APPLICABLE", "READY"] }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["block", "publicEvidence"],
          "properties": {
            "block": { "type": "string", "minLength": 1 },
            "publicEvidence": { "enum": ["OPEN", "PUBLIC_E2E_PASS"] }
          }
        },
        "sources": { "$ref": "#/$defs/sourceList" },
        "note": { "type": ["string", "null"] }
      }
    },
    "unavailableOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "outcome", "intendedOwner", "humanStatus", "aiStatus", "sources"],
      "properties": {
        "actionId": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "intendedOwner": { "type": "string", "minLength": 1 },
        "humanStatus": { "type": "string", "minLength": 1 },
        "aiStatus": { "type": "string", "minLength": 1 },
        "sources": { "$ref": "#/$defs/sourceList" }
      }
    }
  }
}
